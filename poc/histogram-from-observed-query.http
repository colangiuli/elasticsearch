# Read-only example comparing canonical and array-based date filters.
# Replace POC_INDEX with the concrete development index populated by the script.
# Numerical bounds below use an inclusive upper endpoint.
# No request has been executed against your cluster.
# Keys "0" and "dh" are preserved for the existing response consumer.

# 1. Example array histogram request: selection still uses @timestamp.
GET /POC_INDEX/_search?allow_partial_search_results=false
{
  "size": 0,
  "aggs": {
    "0": {
      "filter": {
        "bool": {
          "must": [
            {
              "range": {
                "@timestamp": {
                  "gte": -3061022400000,
                  "lte": 1790950289168
                }
              }
            },
            {
              "range": {
                "@timestamp": {
                  "gte": 1525907486598,
                  "lte": 1790947746282
                }
              }
            },
            { "query_string": { "query": "*" } }
          ]
        }
      },
      "aggs": {
        "dh": {
          "date_histogram": {
            "field": "forensic_all_dates",
            "fixed_interval": "30d"
          }
        }
      }
    }
  }
}

# 2. Proposed first comparison: select AND aggregate on the date array.
# In this example, the second window is wholly contained in the first.
# The single range below therefore uses their intersection.
# Treat this as a proposed replacement for AUTOMATIC temporal filters.
# Intentionally entered analyst constraints on @timestamp are separate criteria.
# Keep any additional text/host/artifact filters present in the real request.
# Compare aggregations["0"].doc_count for selected evidence documents and
# aggregations["0"].dh.buckets for the histogram; their sum is not a unique total.
GET /POC_INDEX/_search?allow_partial_search_results=false
{
  "size": 0,
  "aggs": {
    "0": {
      "filter": {
        "bool": {
          "must": [
            {
              "range": {
                "forensic_all_dates": {
                  "gte": 1525907486598,
                  "lte": 1790947746282
                }
              }
            },
            { "query_string": { "query": "*" } }
          ]
        }
      },
      "aggs": {
        "dh": {
          "date_histogram": {
            "field": "forensic_all_dates",
            "fixed_interval": "30d"
          }
        }
      }
    }
  }
}

# 3. Show records omitted by the canonical filter but matching the array.
# This also includes records with no indexed @timestamp; inspect source values.
# A zero count is possible for this very broad example window. Repeat with a
# narrower window around a secondary MFT timestamp, changing BOTH ranges together.
GET /POC_INDEX/_search?allow_partial_search_results=false
{
  "size": 10,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "forensic_all_dates": {
              "gte": 1525907486598,
              "lte": 1790947746282
            }
          }
        },
        { "query_string": { "query": "*" } }
      ],
      "must_not": [
        {
          "range": {
            "@timestamp": {
              "gte": 1525907486598,
              "lte": 1790947746282
            }
          }
        }
      ]
    }
  }
}

# This comparison does not yet crop out-of-window array values from the chart.
# For histogram bounds and exact partial bucket counts, see verify-array.http.
# The table's own request must also use the selected temporal mode; size:0 here
# means the example histogram requests contain no table records to inspect.
